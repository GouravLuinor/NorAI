# ─────────────────────────────────────────────────────────────────────────────
# NorAI — environment template
# Copy to `.env` and fill in your real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core API keys ────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Supabase (auth + Postgres) ───────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Session pooler URL for local backend (the direct db.<ref>.supabase.co host
# is IPv6-only on some machines). Falls back to SQLite when unset.
DATABASE_URL=

# Frontend build-time vars (read by Vite from repo-root .env)
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Lemon Squeezy billing (P2.5) ─────────────────────────────────────────────
# Checkout links for the /billing page + PricingPage upgrade buttons.
# Fill in when the Lemon Squeezy store exists; /billing returns null until then.
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_CHECKOUT_STARTER_URL=
LEMONSQUEEZY_CHECKOUT_PRO_URL=
LEMONSQUEEZY_CUSTOMER_PORTAL_URL=

# ── Pipeline / free-trial gates ──────────────────────────────────────────────
MAX_FREE_DURATION_MIN=15
# Set to 0 only for local dev WITHOUT a Supabase auth backend.
NORAI_DEV_INSECURE_AUTH=0
# Max upload size in bytes (default 2 GB).
NORAI_MAX_UPLOAD_BYTES=
# Whisper model size: base | small | medium | large-v3 (default small).
NORAI_WHISPER_MODEL=
# Override the pipeline metrics file (default outputs/pipeline_metrics.jsonl).
NORAI_METRICS_FILE=
# Override the Chroma persistent dir (default outputs/tutor/chroma).
NORAI_CHROMA_DIR=
