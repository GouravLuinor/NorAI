# ─────────────────────────────────────────────────────────────────────────────
# NorAI — environment template
# Copy to `.env` and fill in your real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core AI & Environment ───────────────────────────────────────────────────
GEMINI_API_KEY=
NORAI_ENV=development
NORAI_TRANSCRIPTION_BACKEND=gemini
# Comma-separated list of allowed production CORS origins (e.g. https://app.yourdomain.com)
NORAI_ALLOWED_ORIGINS=

# ── Supabase (auth + Postgres) ───────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Session pooler URL for backend (e.g., postgresql+asyncpg://postgres:PASS@db.xyz.supabase.co:5432/postgres)
# Falls back to local SQLite when unset.
DATABASE_URL=

# Frontend build-time vars (read by Vite from repo-root .env)
# Leave VITE_API_BASE_URL empty for single-container / same-origin deployment
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Razorpay Billing (Future Integration) ───────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Pipeline / free-trial gates ──────────────────────────────────────────────
MAX_FREE_DURATION_MIN=15
# Local developer access (1 allows full access to local outputs/ registry without requiring login)
NORAI_DEV_ACCESS=1
# Set to 1 for offline dev without Supabase auth
NORAI_DEV_INSECURE_AUTH=0
# Max upload size in bytes (default 2 GB).
NORAI_MAX_UPLOAD_BYTES=2147483648
# Whisper model size: base | small | medium | large-v3 (default small).
NORAI_WHISPER_MODEL=small
# Override the pipeline metrics file (default outputs/pipeline_metrics.jsonl).
NORAI_METRICS_FILE=
# Override the Chroma persistent dir (default outputs/tutor/chroma).
NORAI_CHROMA_DIR=
