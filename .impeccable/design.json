    "narrative": {
      "northStar": "The university library at closing time.",
      "overview": "NorAI borrows its visual grammar from the physical library: green stack-signage rails, white spine labels, call numbers, brass current-item markers, and reading-room paper. The workspace should feel like a place built for sustained study, not a dashboard built for monitoring. Navigation is signage; content is a sheet on the desk; the tutor is a librarian sitting beside it.",
      "keyCharacteristics": [
        "Library green signage plus warm paper and brass.",
        "Literata for reading, Atkinson Hyperlegible for UI, Mono for call numbers.",
        "Square-ish geometry (3–6px), hairline borders, soft low elevation.",
        "One color per study zone; brass reserved for current position and cited moments.",
        "Light \"reading room\" and dark \"after hours\" themes with equal contrast."
      ],
      "rules": [
        { "section": "Colors", "name": "The One Accent Rule", "body": "Brass is for the current item and citations only; it never fills a whole panel or decorates a heading." },
        { "section": "Colors", "name": "The Zone Rule", "body": "A study mode's color appears on its mode control, its shelf marks, and its accents — nowhere else on the screen." },
        { "section": "Colors", "name": "The Ink Border Rule", "body": "Borders are translucent ink, not a second neutral. If a border needs to be more visible, increase alpha, not blueness." },
        { "section": "Typography", "name": "The 12px Floor Rule", "body": "Nothing renders below 12px. Small steps in the token ramp resolve to 12px or 13px rather than shrinking further." },
        { "section": "Typography", "name": "The Reading Serif Rule", "body": "Literata is for content the student reads at length; never set controls, labels, or navigation in it." },
        { "section": "Typography", "name": "The Shelf-Mark Rule", "body": "Any timestamp, chapter range, or citation that can seek the video is set in mono and carries the shelf-mark treatment." },
        { "section": "Elevation & Depth", "name": "The Flat-At-Rest Rule", "body": "A static card has a border, not a shadow. Shadows respond to state or float above the page." },
        { "section": "Elevation & Depth", "name": "The Rail-Is-A-Plane Rule", "body": "The rail never floats, blurs, or gradients; it is painted signage." }
      ],
      "dos": [
        "Use library green for navigation and primary action; use brass for the current item and citations.",
        "Set timestamps, chapter ranges, and citations in mono with the shelf-mark treatment.",
        "Keep study modes color-coded and visually separate.",
        "Use Literata for long-form reading and Atkinson Hyperlegible for every control.",
        "Prefer hairline ink borders and tone shifts over shadows and rounded floating cards.",
        "Hold the 12px type floor and the 68ch reading measure."
      ],
      "donts": [
        "Don't reintroduce grid paper, noise, fold marks, hard offset shadows, or red-pencil annotations.",
        "Don't use uppercase mono kickers; labels are sentence case.",
        "Don't use brass as a general highlight or fill large areas with it.",
        "Don't mix zone colors within one panel or use status red/green for decoration.",
        "Don't set UI or navigation in Literata, or body copy below 12px.",
        "Don't add stock imagery, invented testimonials, user counts, or university affiliations."
      ]
    }
